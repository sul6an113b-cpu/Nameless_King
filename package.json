{
  "name": "looplab",
  "private": true,
  "type": "module",
  "description": "LoopLab \u2014 local systems-thinking workbench (CLD, loops, archetypes, SFD simulation, leverage, decision brief).",
  "workspaces": [
    "packages/core",
    "packages/content",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "run-p -l dev:web dev:server",
    "dev:web": "npm run dev -w @looplab/web",
    "dev:server": "node --watch apps/server/src/main.ts",
    "build": "npm run typecheck && npm run build -w @looplab/web",
    "start": "node apps/server/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core && tsc -p packages/content && tsc -p apps/server && tsc -p apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/check-skips.mjs && vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "smoke:copilot": "node apps/server/scripts/smoke-copilot.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
