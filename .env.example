# Copy to .env (git-ignored) and fill in. The server reads it; the browser never sees it.
# Anthropic API key — server-only. Never commit, print, or paste it anywhere.
ANTHROPIC_API_KEY=
# Model id from the official models overview (docs: "start with Claude Opus 5.5"). Never guess a slug.
CLAUDE_MODEL=claude-opus-5-5
# Cheaper/faster alternative:
# CLAUDE_MODEL=claude-sonnet-5-5
# Copilot server port (binds 127.0.0.1 only).
PORT=8787
# Browser origin(s) allowed to call /api in development (comma-separated).
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
